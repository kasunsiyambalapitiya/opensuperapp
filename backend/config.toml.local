[superapp_mobile_service]
userRegionFilter=""
mobileAppReviewerEmail=""
regionRestrictedMicroApps=["", "", ""]

[superapp_mobile_service.authorization]
# Optional, unlike the rest of this file: left out, the defaults in
# modules/authorization/access.bal apply. An empty entry is not "no
# restriction", it denies everyone.
#businessCardAllowedDomains=["example.com"]
#businessCardAllowedGroups=["example-employees"]

[superapp_mobile_service.database]
defaultMicroAppsGroup=""

[superapp_mobile_service.database.databaseConfig]
host=""
user=""
password=""
database=""
port=

[superapp_mobile_service.database.databaseConfig.connectionPool]
maxOpenConnections=
maxConnectionLifeTime=
minIdleConnections=

[superapp_mobile_service.entity]
hrEntityBaseUrl = ""
    [superapp_mobile_service.entity.oauth2Config]
    tokenUrl = "",
    clientId = "",
    clientSecret = ""

[superapp_mobile_service.entity.retryConfig]
count=
interval=
backOffFactor=
maxWaitInterval=

[superapp_mobile_service.scim]
scimUrl=""
    [superapp_mobile_service.scim.oauth2Config]
    tokenUrl=""
    clientId=""
    clientSecret=""
    scopes=[""]

[superapp_mobile_service.wallet]
walletServiceBaseUrl=""
    
[ballerina.log]
level = ""
